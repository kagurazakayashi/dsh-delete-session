{
  "name": "@kagurazakayashi/dsh-delete-session",
  "version": "1.1.0",
  "description": "A minimal DeepSeek Harness Web plugin that appends a delete-session item below the archive-session item in the sidebar session row menu, resolved by an exact displayTitle + relative-time match. It also registers a Plugins-settings card for choosing how deletion is confirmed.",
  "license": "MIT",
  "author": "KagurazakaYashi(KagurazakaMiyabi)",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "session-management",
    "session-delete"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kagurazakayashi/dsh-delete-session.git"
  },
  "homepage": "https://github.com/kagurazakayashi/dsh-delete-session#readme",
  "bugs": "https://github.com/kagurazakayashi/dsh-delete-session/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "screenshot.png",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.3-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.3-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-api-workspace-controller": ">=0.1.3-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.3-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.3-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.1.3-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.3-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-session": ">=0.1.3-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.3-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.3-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-workspace": ">=0.1.3-alpha.2 <0.2.0-0"
  }
}
